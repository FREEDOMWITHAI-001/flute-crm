{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 300 }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/cron/sync", "schedule": "30 20 * * *" }]
}
