{
  "name": "flute-gandharvas-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Flute Gandharvas CRM - module 1: Hackathon attendance & retention (Zoom + TagMango)",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
