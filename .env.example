# ---- Server ----
PORT=3000
# Public address of this app (used for the TagMango webhook URL), e.g. https://crm.flutegandharvas.com
PUBLIC_URL=
# Set to true when served over https
COOKIE_SECURE=false
# Minutes between automatic syncs (0 = only manual "Sync now")
SYNC_INTERVAL_MINUTES=60

# ---- Database ----
# Postgres connection string (Supabase: Project Settings -> Database -> Connection string, "Session pooler").
# Leave empty to use the built-in local database in ./data/pg (fine for testing).
DATABASE_URL=

# ---- First admin (created only when there are no users yet) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---- Zoom: one Server-to-Server OAuth app per account ----
# Zoom Marketplace -> Develop -> Build App -> Server-to-Server OAuth. Scopes (read-only):
#   meeting:read:admin  report:read:admin  user:read:admin
# (granular names: meeting:read:meeting:admin, meeting:read:list_past_instances:admin,
#  meeting:read:list_registrants:admin, meeting:read:list_meetings:admin,
#  report:read:meeting:admin, report:read:list_meeting_participants:admin, user:read:list_users:admin)
ZOOM_1_LABEL=connect@daveharsh.com
ZOOM_1_ACCOUNT_ID=
ZOOM_1_CLIENT_ID=
ZOOM_1_CLIENT_SECRET=
ZOOM_2_LABEL=
ZOOM_2_ACCOUNT_ID=
ZOOM_2_CLIENT_ID=
ZOOM_2_CLIENT_SECRET=

# ---- TagMango ----
# Dashboard -> Automation -> Platform Integrations -> API key
TAGMANGO_API_KEY=
# Any long random string; it goes in the webhook URL so only TagMango can post to it
TAGMANGO_WEBHOOK_SECRET=
# Optional: only send events for this mango (product) id
TAGMANGO_MANGO_ID=
# Optional: a list-orders endpoint if Ganesh's TagMango access has one (JSON list of orders)
TAGMANGO_PULL_URL=
